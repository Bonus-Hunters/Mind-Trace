{
  "name": "Mind-Trace",
  "displayName": "Mind Trace",
  "description": "",
  "icon":"./images/notebook-pen.png",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
        "viewsContainers": {
        "secondarySidebar": [
          {
            "id": "my-extension-sidebar",
            "title": "Mind Trace",
            "icon": "./media/extension-icon.svg"
          }
        ]
      },"views": {
        "my-extension-sidebar": [
          {
            "type": "webview",
            "id": "my-sidebar-view",
            "name": ""
          }
        ]
      },
    "commands": [
      {
        "command": "Mind-Trace.runextension",
        "title": "Run Extension",
        "category": "Mind Trace"
      },
     {  "command": "Mind-Trace.logout",
        "title": "Logout",
        "category": "Mind Trace"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test",
    "watch-css": "tailwindcss -i ./src/input.css -o ./media/output.css --watch",
    "watch-extension": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "css-loader": "^7.1.3",
    "eslint": "^9.39.2",
    "style-loader": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "axios": "^1.13.5"
  }
}
